{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pylemma",
  "main": "worker.js",
  "account_id": "24f97aae6afe0315dac069a5c08fe795",
  "compatibility_date": "2026-10-28",
  "routes": [
    {
      "pattern": "pylemma.aor.fyi",
      "custom_domain": true
    }
  ],
  "workers_dev": true,
  "assets": {
    "directory": "../../src/pylemma/web/static",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "containers": [
    {
      "class_name": "Pylemma",
      "image": "registry.cloudflare.com/24f97aae6afe0315dac069a5c08fe795/pylemma@sha256:5ead653a1dde6ddf172f55f4ed6fc0a6f73cd6ae3d4863c392a0db1a5f6cb354",
      "instance_type": "lite",
      "max_instances": 1
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "GAME",
        "class_name": "Pylemma"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "Pylemma"
      ]
    }
  ],
  "version_metadata": {"binding": "VERSION_METADATA"},
  "observability": {
    "enabled": true
  },
  "vars": {
    "LOGFIRE_BASE_URL": "https://logfire-eu.pydantic.dev",
    "LOGFIRE_PROJECT_URL": "https://logfire-eu.pydantic.dev/nibzard/starter-project/",
    "LOGFIRE_PUBLIC_TRACES": "{\"01a18279f80e04757e90f2b753321bc4\":\"https://logfire-eu.pydantic.dev/public-trace/44e57f30-c25a-47fe-b85f-5db1d0604010?spanId=4ed36f7dff63d8fe\"}"
  },
  "preview_urls": false
}
